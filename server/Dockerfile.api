FROM node:18-slim AS builder

# Cài đặt dependencies cần thiết
RUN apt-get update && apt-get install -y \
    python3 \
    python3-pip \
    libsndfile1 \
    espeak-ng \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Sao chép package.json trước để tận dụng cache
COPY package*.json ./
RUN npm install

# Sao chép source code
COPY . .

# Build nếu cần
RUN npm run build --if-present

# Stage 2: Tạo image cuối cùng gọn hơn
FROM node:18-slim

# Cài đặt dependencies cần thiết cho production
RUN apt-get update && apt-get install -y \
    python3 \
    python3-pip \
    libsndfile1 \
    espeak-ng \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Sao chép package.json và package-lock.json
COPY package*.json ./
RUN npm install --only=production

# Sao chép code từ builder
COPY --from=builder /app .

# Tạo thư mục models (chỉ cho OPUS-MT, không cần EnVi-T5)
RUN mkdir -p /app/models/phowhisper /app/models/opus_mt

# Thiết lập môi trường
ENV NODE_ENV=production
ENV PORT=5000

# Mở cổng
EXPOSE 5000

# Khởi động ứng dụng
CMD ["node", "api/server.js"]