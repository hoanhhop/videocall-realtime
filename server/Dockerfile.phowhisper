# Sử dụng image PyTorch làm base
FROM pytorch/pytorch:latest

# Đặt thư mục làm việc
WORKDIR /app

# Copy file requirements và cài đặt thư viện Python
COPY scripts/requirements.txt .
# Cập nhật pip và cài đặt grpcio-tools trước để tránh lỗi build wheel
RUN pip install --no-cache-dir --upgrade pip && \
    pip install --no-cache-dir grpcio-tools && \
    pip install --no-cache-dir -r requirements.txt

# Copy mã nguồn ứng dụng (bao gồm scripts và protos)
COPY scripts /app/scripts
COPY protos /app/protos

# Tạo mã gRPC từ file .proto (chạy khi build image)
RUN python -m grpc_tools.protoc \
    -I protos \
    --python_out=protos \
    --grpc_python_out=protos \
    protos/speech.proto

# Sửa file run_phowhisper.py để hỗ trợ định dạng pytorch_model.bin
RUN sed -i 's/"use_safetensors": True/"use_safetensors": False/g' /app/scripts/run_phowhisper.py

# Cài đặt grpc_health_probe
RUN apt-get update && apt-get install -y wget && apt-get clean && rm -rf /var/lib/apt/lists/* && \
    wget -q https://github.com/grpc-ecosystem/grpc-health-probe/releases/latest/download/grpc_health_probe-linux-amd64 -O /usr/local/bin/grpc_health_probe && \
    chmod +x /usr/local/bin/grpc_health_probe

# Tạo các thư mục cần thiết cho mounting
RUN mkdir -p /app/models /app/.cache/huggingface /app/.cache/torch /app/logs

# Mở cổng gRPC
EXPOSE 50051

# Đặt biến môi trường
ENV PYTHONUNBUFFERED=1
ENV GRPC_POLL_STRATEGY=poll

# Đặt entrypoint
ENTRYPOINT ["python", "scripts/run_phowhisper.py"]

# Command mặc định
CMD ["--model_path", "models/phowhisper/PhoWhisper-base", "--port", "50051"] 