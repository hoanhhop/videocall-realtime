# Single stage Dockerfile for Socket service with bcrypt support
FROM node:18-slim

# Install ALL dependencies including build tools for bcrypt
RUN apt-get update && apt-get install -y --no-install-recommends \
    python3 \
    python3-pip \
    libsndfile1 \
    espeak-ng \
    build-essential \
    python3-dev \
    make \
    g++ \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Copy package files first for better caching
COPY package*.json ./

# Install ALL dependencies (production + dev for native modules)
RUN npm install

# Copy all source code
COPY . .

# Create models directory
RUN mkdir -p /app/models/opus_mt

# Set environment
ENV NODE_ENV=production
ENV PORT=4000

# Expose port
EXPOSE 4000

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=30s --retries=3 \
  CMD curl -f http://localhost:4000/health || exit 1

# Start application
CMD ["node", "socket/server.js"]
