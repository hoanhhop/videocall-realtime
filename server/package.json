{
    "name": "video-call-translation-server",
    "version": "1.0.0",
    "description": "Video Call Translation API Server with Integration Support",
    "main": "index.js",
    "scripts": {
        "start": "node api/server.js",
        "start:socket": "node socket/server.js",
        "start:integration": "node integrationServer.js",
        "dev": "nodemon index.js",
        "dev:socket": "nodemon socket-server.js",
        "dev:integration": "nodemon integrationServer.js",
        "test": "jest",
        "startAll": "powershell -File ..\\start-servers.ps1",
        "deploy:integration": "node deployIntegration.js",
        "setup:integration": "node setupIntegration.js",
        "health:integration": "curl -f http://localhost:3001/health || exit 1"
    },    "dependencies": {
        "@grpc/grpc-js": "^1.13.3",
        "@grpc/proto-loader": "^0.7.15",
        "@tensorflow/tfjs-node": "^4.18.0",
        "axios": "^1.9.0",
        "bcrypt": "^5.1.0",
        "body-parser": "^1.20.2",
        "compression": "^1.7.4",
        "cors": "^2.8.5",
        "dotenv": "^16.3.1",
        "express": "^4.18.2",
        "express-rate-limit": "^6.10.0",        
        "helmet": "^7.0.0",
        "jsonwebtoken": "^9.0.2",
        "mammoth": "^1.6.0",
        "multer": "^1.4.5-lts.1",
        "mysql2": "^3.6.0",
        "natural": "^6.12.0",
        "socket.io": "^4.7.2",
        "uuid": "^9.0.0",
        "winston": "^3.10.0",
        "vectordb": "^0.19.1"
    },
    "devDependencies": {
        "jest": "^29.6.4",
        "nodemon": "^3.0.1",
        "supertest": "^6.3.3"
    },
    "engines": {
        "node": ">=18.0.0"
    }
}
